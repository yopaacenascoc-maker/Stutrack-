                System.out.print("Choose: ");
                while (!sc.hasNextInt()) {
                    System.out.println("Invalid input. Please enter a number between 1 and 5.");
                    sc.nextLine();
                    System.out.print("Choose: ");
                }
                choice = sc.nextInt();
                sc.nextLine();
            }

           if (choice == 1) {

    
    System.out.print("Enter category: ");
